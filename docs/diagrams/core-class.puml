@startuml core-class
!pragma layout smetana
title Core contracts and borrowed dependencies
class InspectionJob {
  JobId
  Samples (read-only snapshot)
  LowerBound / UpperBound
}
class InspectionResult {
  RunId / JobId
  StartedAtUtc / InspectedAtUtc
}
class InspectionAssessment {
  SampleCount / DefectCount
  Score / Verdict
}
class InspectionRunner {
  RunAsync(job, cancellationToken)
}
class InspectionEngine {
  Start(job, timeout)
  GetStatus() / GetRun(runId)
  CancelRun(runId)
  DisposeAsync()
}
class InspectionRunHandle {
  RunId / JobId
  Completion
}
class InspectionRunSnapshot {
  State / Stage / StopReason
  ComputedResult / Error / StopError
}
interface IDevice {
  PrepareAsync(job, token)
  AcquireAsync(job, token)
}
interface IInspector {
  InspectAsync(job, samples, token)
}
interface IResultStore {
  SaveAsync(result, token)
}
InspectionRunner --> IDevice : borrows
InspectionEngine --> InspectionRunner : borrows / one active run
InspectionEngine ..> InspectionRunHandle : admission
InspectionEngine ..> InspectionRunSnapshot : immutable snapshot
InspectionRunHandle ..> InspectionRunSnapshot : completion result
InspectionRunner --> IInspector : borrows
InspectionRunner --> IResultStore : borrows
InspectionRunner ..> InspectionJob
InspectionRunner ..> InspectionResult
InspectionResult --> InspectionAssessment : immutable value
@enduml
