@startuml core-class
!pragma layout smetana
title Core contracts and borrowed dependencies
class InspectionJob {
  JobId
  Samples (read-only snapshot)
  LowerBound / UpperBound
}
class InspectionResult {
  RunId / JobId
  StartedAtUtc / InspectedAtUtc
}
class InspectionAssessment {
  SampleCount / DefectCount
  Score / Verdict
}
class InspectionRunner {
  RunAsync(job, cancellationToken)
}
class InspectionEngine {
  Start(job, timeout)
  StartAuto(job, interval, timeout, maxRuns)
  GetAuto(autoId) / StopAuto(autoId)
  GetStatus() / GetRun(runId)
  CancelRun(runId)
  DisposeAsync()
}
class InspectionRunHandle {
  RunId / JobId
  Completion
}
class InspectionAutoHandle {
  AutoId / Completion
}
class InspectionAutoSnapshot {
  AutoId / State / StopReason
  CurrentRunId / LastRun
  StartedRuns / CompletedRuns / NextRunAtUtc
}
class InspectionRunSnapshot {
  State / Stage / StopReason
  ComputedResult / Error / StopError
  TerminationConfirmed (null / true / false)
}
class InspectionTerminationException {
  TerminationConfirmed
}
interface IDevice {
  PrepareAsync(job, token)
  AcquireAsync(job, token)
}
interface IInspector {
  InspectAsync(job, samples, token)
}
interface IResultStore {
  SaveAsync(result, token)
}
interface IResultReader {
  LoadAsync(runId, token)
}
interface IResultSearch {
  SearchAsync(query, token)
}
class InspectionResultQuery {
  FromUtc / ToUtc / Verdict / JobId
  Limit (1..25) / Cursor
}
class InspectionResultPage {
  Items / NextCursor
}
interface IInspectionDiagnostics {
  Record(diagnostic)
}
class InspectionDiagnostic {
  EventName / RunId / JobId / AutoId
  Stage / Outcome
}
IResultReader ..> InspectionResult
IResultSearch ..> InspectionResultQuery
IResultSearch ..> InspectionResultPage
InspectionEngine --> IInspectionDiagnostics : borrows / outside engine lock
IInspectionDiagnostics ..> InspectionDiagnostic
InspectionRunner --> IDevice : borrows
InspectionEngine --> InspectionRunner : borrows / one active run
InspectionEngine ..> InspectionRunHandle : admission
InspectionEngine ..> InspectionAutoHandle : reserves running and waiting session
InspectionAutoHandle ..> InspectionAutoSnapshot : session completion
InspectionAutoSnapshot --> InspectionRunSnapshot : last completed run only
InspectionEngine ..> InspectionRunSnapshot : immutable snapshot
InspectionEngine ..> InspectionTerminationException : Faulted / reject new runs
InspectionRunHandle ..> InspectionRunSnapshot : completion result
InspectionRunner --> IInspector : borrows
InspectionRunner --> IResultStore : borrows
InspectionRunner ..> InspectionJob
InspectionRunner ..> InspectionResult
InspectionResult --> InspectionAssessment : immutable value
@enduml
